# =============================================================================
#  IBM Quantum Live Telemetry Dashboard  --  environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in the two IBM values to enable Live Mode.
#  Leave them blank and the dashboard runs perfectly in Simulated Telemetry mode.
#
#      cp .env.example .env
#
#  `.env` is git-ignored. Never commit real credentials.
# -----------------------------------------------------------------------------

# --- IBM Quantum credentials (optional -- blank = mock mode) ------------------
# 1. Create an IBM Cloud API key:  https://cloud.ibm.com/iam/apikeys
IBM_QUANTUM_API_KEY=

# 2. Copy the Service CRN of your Quantum instance from
#    https://quantum.cloud.ibm.com/  ->  Instances  ->  (your instance)
#    It looks like: crn:v1:bluemix:public:quantum-computing:us-east:a/....::
IBM_QUANTUM_CRN=

# --- IBM API endpoints --------------------------------------------------------
# Use the eu-de host instead if your instance lives in the EU region:
#   https://eu-de.quantum.cloud.ibm.com/api/v1
IBM_QUANTUM_API_URL=https://quantum.cloud.ibm.com/api/v1
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# Required by every IBM Quantum REST call. Pin it; do not send a floating date.
IBM_API_VERSION=2024-01-01

# --- Poller behaviour ---------------------------------------------------------
# Seconds between polls of IBM. Must stay >= 10 to respect IBM rate limits.
POLL_INTERVAL_SECONDS=12

# Force simulated telemetry even when credentials are present (useful for demos).
FORCE_MOCK_MODE=false

# --- History (SQLite) ---------------------------------------------------------
ENABLE_HISTORY=true
HISTORY_DB_PATH=./data/telemetry.sqlite3
HISTORY_RETENTION_DAYS=7

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins allowed to reach the API during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
