# Build contexts are the repo root for both images, so everything heavy or
# host-specific must be excluded or it is uploaded to the daemon on every build.

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node -- reinstalled inside the image from the lockfile
frontend/node_modules/
frontend/dist/
.vite/

# Secrets must never be baked into an image; compose passes them at runtime.
.env
.env.local

# Local state
backend/data/
*.sqlite3
*.sqlite3-journal

# VCS / editor / OS
.git/
.gitignore
.claude/
.DS_Store

# Docs are not needed at runtime
docs/
README.md
